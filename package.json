{
  "name": "arcad-view",
  "private": true,
  "version": "2.1.19",
  "description": "Arcad View — offline CAD viewing, measurement and markup by GUI's Arc Industry",
  "license": "GPL-3.0-only",
  "author": {
    "name": "İZ",
    "email": "tepukmenajeri@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gamzagui-collab/ArcadView-Source.git"
  },
  "bugs": {
    "url": "https://github.com/gamzagui-collab/ArcadView-Source/issues"
  },
  "homepage": "https://github.com/gamzagui-collab/ArcadView-Source",
  "keywords": [
    "android",
    "cad",
    "dxf",
    "dwg",
    "offline",
    "viewer",
    "webassembly"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "postinstall": "node scripts/patch-capacitor-safe-area.mjs && node scripts/patch-cad-controls.mjs",
    "prebuild": "node scripts/patch-capacitor-safe-area.mjs && node scripts/patch-cad-controls.mjs && node scripts/copy-cad-runtime.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run && npm run test:safe-area && npm run test:release && npm run test:cad-runtime",
    "test:safe-area": "node --test scripts/tests/safe-area-patch.mjs",
    "test:release": "node --test scripts/tests/github-release.mjs scripts/tests/public-source.mjs",
    "test:watch": "vitest",
    "android:add": "cap add android && node scripts/configure-android.mjs",
    "android:sync": "npm run build && cap sync android && node scripts/configure-android.mjs",
    "android:verify": "node scripts/verify-android.mjs",
    "android:verify:release": "node scripts/verify-android-release.mjs",
    "check": "npm run test && npm run android:prepare",
    "android:prepare": "npm run android:sync && npm run android:verify",
    "android:ld-debug": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/android-ld-debug.ps1",
    "test:cad-runtime": "node --test scripts/tests/dwg-memory-runtime.mjs scripts/tests/native-library-check.mjs scripts/tests/cad-controls-patch.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.4.3",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.4.3",
    "@mlightcad/libredwg-web": "0.9.0",
    "dxf-viewer": "1.0.48",
    "fflate": "0.8.3",
    "libarchive-wasm": "1.2.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.161.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@types/node": "24.7.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.161.2",
    "@vitejs/plugin-react": "5.0.4",
    "fake-indexeddb": "6.2.4",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
